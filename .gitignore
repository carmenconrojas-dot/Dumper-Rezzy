.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
.cursor/
.c9/
*.launch
.settings/
.project
.classpath

# ─── Coverage / testing ──────────────────────────────────────────────────────
coverage/
.nyc_output/
