# ─────────────────────────────────────────────────────────────────────────────
# Rezzy Env Logger — Environment Variables
# Copy this file to .env (for local dev) or set these in Railway > Variables.
# Never commit real values to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Discord Bots ──────────────────────────────────────────────────────────────
# Main bot token (bot.py)
DISCORD_TOKEN=MTU0NTE0Mjg2MDU1MzEyNTk5MA.GcFS-6.O-IpeoFalhc_ewDXMom7xNtke7oBockQ0myizk

# AI companion bot token (botai.py)
AI_DISCORD_TOKEN=your_ai_bot_token_here

# ── Ownership & Server ────────────────────────────────────────────────────────
# Your Discord user ID (main bot owner)
OWNER_ID=your_discord_user_id

# AI bot owner Discord user ID (can be the same as OWNER_ID)
AI_OWNER_ID=your_discord_user_id

# Your Discord server (guild) ID
GUILD_ID=your_guild_id

# ── Channel IDs ───────────────────────────────────────────────────────────────
# Main commands channel
CMDS_CHANNEL_ID=your_cmds_channel_id

# Dump / log output channel
DUMP_CHANNEL_ID=your_dump_channel_id

# Restricted channel for .l3 (status-gated)
STATUS_CHANNEL_ID=your_status_channel_id

# Secondary allowed command channels
CMDS_CHANNEL_2_ID=your_cmds_channel_2_id
CMDS_CHANNEL_3_ID=your_cmds_channel_3_id

# ── Role IDs ──────────────────────────────────────────────────────────────────
# Role granted automatically when the user's Discord status contains STATUS_STRING
STATUS_ROLE_ID=your_status_role_id

# ── Status gate ───────────────────────────────────────────────────────────────
# Exact text users must have in their Discord custom status to get access.
# Default: Rezzy on Top | discord.gg/f8XjPE2c6Y
STATUS_STRING=Rezzy on Top | discord.gg/f8XjPE2c6Y

# Role granted after verification
VERIFY_ROLE_ID=your_verify_role_id

# ── API Keys — Main Bot ───────────────────────────────────────────────────────
# GitHub Personal Access Token
GITHUB_TOKEN=ghp_your_github_token

# Moonveil obfuscator API key
MV_API_KEY=mv-secret-your_moonveil_key

# Discord webhook URL (for internal alerts)
WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Discord user auth token (for message search API — optional)
DISCORD_AUTH_TOKEN=your_discord_user_token

# Discord cookie (for message search API — optional)
DISCORD_COOKIE=your_discord_cookie_string

# ── API Keys — AI Bot (botai.py) ──────────────────────────────────────────────
# Google Gemini API key
GOOGLE_API_KEY=AIzaSy_your_google_api_key

# Groq API key
GROQ_API_KEY=gsk_your_groq_api_key

# Z.AI (GLM) API key
ZAI_API_KEY=your_zai_api_key

# HuggingFace API key (for Gradio client)
HF_API_KEY=hf_your_huggingface_token

# OpenRouter API key
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key

# NVIDIA NIM API key
NVIDIA_API_KEY=nvapi-your_nvidia_key

# Mistral API key
MISTRAL_API_KEY=your_mistral_api_key

# ── bypass.py ─────────────────────────────────────────────────────────────────
# SilentHub bypass service credentials
SILENT_TOKEN=your_silent_token
SILENT_HASH=your_silent_hash
